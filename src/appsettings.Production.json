{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Limits": {
            "MaxConcurrentConnections": 100,
            "MaxConcurrentUpgradedConnections": 100,
            "MaxRequestBodySize": 52428800
        },
        "Endpoints": {
            "Http": {
                "Url": "http://+:80"
            }
        }
    }
}
